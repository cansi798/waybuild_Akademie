---
// /kontakt/ (US-16): einfacher Kontakt per E-Mail. Kontaktformular ausgeblendet (Can #7207, 24.11.) –
// bewusst reduziert für die Veröffentlichung; Formular folgt in einer späteren Ausbaustufe.
import Basis from '../../layouts/Basis.astro';
import { AKADEMIE } from '../../lib/site';
import { href } from '../../lib/pfad';
---

<Basis titel="Kontakt – Fragen zu Kursen und Weiterbildung" beschreibung="Fragen zu Kursen oder zur Weiterbildung bei der waybuild Akademie? Schreib uns einfach eine E-Mail an info@waybuild-akademie.de – wir antworten in der Regel innerhalb von zwei Werktagen.">
  <section class="rahmen mx-auto max-w-2xl pt-8 pb-16 text-center sm:pt-12 sm:pb-24">
    <p class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold ring-1 ring-base-300">
      <span class="size-2.5 rounded-full bg-bernstein" aria-hidden="true"></span>
      Frag uns einfach
    </p>
    <h1 class="trennen mt-5 text-4xl sm:text-5xl">Kontakt</h1>
    <p class="mt-4 text-lg text-gedaempft">
      Du weißt nicht, welcher Kurs passt, oder möchtest mehrere Mitarbeitende weiterbilden?
      Schreib uns einfach eine E-Mail – wir antworten in der Regel innerhalb von zwei Werktagen.
    </p>

    <div class="mt-8">
      <a href={`mailto:${AKADEMIE.mailInfo}`} class="group inline-flex items-center gap-4 rounded-2xl bg-white p-6 text-left ring-1 ring-base-300 hover:ring-navy">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-navy text-white" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-6"><path d="M4 6h16v12H4zM4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        </span>
        <span class="min-w-0">
          <span class="block text-sm text-gedaempft">E-Mail schreiben</span>
          <span class="trennen block text-lg font-semibold underline decoration-bernstein decoration-2 underline-offset-4">{AKADEMIE.mailInfo}</span>
        </span>
      </a>
    </div>

    <p class="mt-8 text-sm text-gedaempft">
      Oder stell uns direkt eine <a class="link-fliess" href={href('/#anfrage')}>unverbindliche Kurzanfrage</a> zu einem Kurs –
      dann melden wir uns mit allen Infos bei dir.
    </p>
  </section>
</Basis>

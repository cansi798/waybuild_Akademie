---
// /anmeldung/?kurs=<slug>&termin=<id> (US-10 … US-13) bzw. ?kurs=pruefungscoaching&paket=<id> (US-15).
// Seit #6771 eine unverbindliche Buchungsanfrage zu einem bestimmten Termin (Weg über die Terminkarten der Kursseite);
// Hauptweg auf Startseite und Berufsseiten ist die Kurzanfrage (AnfrageFormular).
import Basis from '../../layouts/Basis.astro';
import AnmeldeFormular from '../../components/formulare/AnmeldeFormular.astro';
import { href } from '../../lib/pfad';
---

<Basis titel="Buchungsanfrage zum Live-Online-Kurs" beschreibung="Frag deinen Live-Online-Kurs der waybuild Akademie unverbindlich an: Termin wählen, Angaben prüfen, absenden. Du bekommst ein Buchungsangebot per E-Mail – verbindlich erst mit deiner Zusage und unserer Bestätigung.">
  <section class="rahmen pt-8 pb-16 sm:pt-12 sm:pb-24">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold ring-1 ring-base-300">
        <span class="size-2.5 rounded-full bg-bernstein" aria-hidden="true"></span>
        Unverbindliche Anfrage in fünf kurzen Schritten
      </p>
      <h1 class="trennen mt-5 text-4xl sm:text-5xl">Frag deinen Kurs unverbindlich an</h1>
      <p class="mt-4 text-lg text-gedaempft">
        Wähle Kurs und Termin, trag die Teilnehmer (m/w/d) ein und sag uns, wer die Rechnung bekommt. Wir schicken dir ein Buchungsangebot per E-Mail – verbindlich wird es erst mit deiner Zusage und unserer Bestätigung.
        Fragen vorab? <a class="link-fliess" href={href('/kontakt/')}>Schreib uns</a>.
      </p>
    </div>
    <div class="mt-10">
      <AnmeldeFormular />
    </div>
  </section>
</Basis>

import { href } from '../../lib/pfad';
import { IS_PREVIEW } from '../../lib/env';

const abschnitte = [
  { id: 'verantwortlicher', titel: 'Verantwortlicher' },
  { id: 'grundsaetze', titel: 'Das Wichtigste in Kürze' },
  { id: 'hosting', titel: 'Hosting und Server-Logfiles' },
  { id: 'formulare', titel: 'Formulare auf dieser Website' },
  { id: 'e-mail', titel: 'E-Mail-Kontakt und Bestätigungen' },
  { id: 'rechnung', titel: 'Rechnung, Buchhaltung und Aufbewahrung' },

---
// FAQ (US-17): alle Fragen gruppiert, ausklappbar, ohne JavaScript lesbar, FAQPage-Schema.
// Wortwahl laut Rulings: nur Live-Unterricht (keine Mitschnitte/Selbstlernen), keine Förderhinweise,
// keine Mindestzahl/Plätze, Endpreise „alles inklusive“, Storno laut GR-05 (vor Livegang rechtlich prüfen).
import Basis from '../../layouts/Basis.astro';
import FaqVerzeichnis from '../../components/seiten/FaqVerzeichnis.astro';
import IhkHinweis from '../../components/seiten/IhkHinweis.astro';
import Seitenkopf from '../../components/seiten/Seitenkopf.astro';
import { faqSchema, type FaqEintrag } from '../../components/seiten/schema';
import { href } from '../../lib/pfad';
import { AKADEMIE } from '../../lib/site';
import { FAQ_GRUPPEN, fragen } from '../../lib/faq';

// Fragen aus der gemeinsamen Quelle lib/faq.ts (auch von /pruefungsvorbereitung/ und /coaching/ genutzt).
const GRUPPEN: { id: string; titel: string; fragen: FaqEintrag[] }[] = FAQ_GRUPPEN.map((g) => ({ id: g.id, titel: g.titel, fragen: fragen(...g.ids) }));

const alle = GRUPPEN.flatMap((g) => g.fragen);
---

<Basis titel="Häufige Fragen zu Kursen und Anmeldung" beschreibung="Antworten zu Anmeldung, Rechnung, Live-Unterricht, IHK-Prüfung und Weiterbildung bei der waybuild Akademie – kurz und klar. Deine Frage fehlt? Schreib uns." schema={[faqSchema(alle)]}>
  <Seitenkopf kicker="FAQ" titel="Häufige Fragen" text="Kurze Antworten auf das, was andere vor der Anmeldung wissen wollten.">
    <nav aria-label="Themen" class="mt-7">
      <ul class="flex flex-wrap gap-2">
        {
          GRUPPEN.map((g) => (
            <li>
              <a href={`#${g.id}`} class="inline-flex min-h-11 items-center rounded-full bg-white px-4 font-semibold ring-1 ring-base-300 hover:bg-base-200">
                {g.titel}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Seitenkopf>

  <div class="rahmen grid gap-16 py-14 sm:gap-20 sm:py-16">
    {
      GRUPPEN.map((g) => (
        <section id={g.id} class="scroll-mt-24" aria-labelledby={`${g.id}-titel`} data-faq-gruppe={g.id}>
          <FaqVerzeichnis eintraege={g.fragen} id={g.id} name={g.titel}>
            <h2 slot="kopf" id={`${g.id}-titel`} class="text-3xl sm:text-4xl">{g.titel}</h2>
          </FaqVerzeichnis>
        </section>
      ))
    }
  </div>

  <div class="rahmen grid gap-6 pb-20 lg:grid-cols-2">
    <div class="rounded-3xl bg-navy p-7 text-white sm:p-8">
      <h2 class="text-2xl sm:text-3xl">Deine Frage ist nicht dabei?</h2>
      <p class="mt-3 text-white/85">Schreib uns – wir helfen dir gern weiter.</p>
      <p class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={href('/kontakt/')} class="btn btn-accent rounded-full px-6">Zum Kontakt</a>
        <a href={`mailto:${AKADEMIE.mailInfo}`} class="inline-flex min-h-11 items-center font-semibold text-white underline underline-offset-4 hover:no-underline">{AKADEMIE.mailInfo}</a>
      </p>
    </div>
    <IhkHinweis />
  </div>
</Basis>

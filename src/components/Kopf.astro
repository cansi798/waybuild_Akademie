---
// Kopf (Can #6771): Logo, knappes Hauptmenü (Prüfungsvorbereitung · IHK-Weiterbildung · waybuild Weiterbildung · Kontakt)
// und der feste Knopf „Anfragen“ (→ Kurzanfrage auf der Startseite). Der Kopf bleibt beim Scrollen oben (sticky).
// Mobil als <details>-Menü: per Tastatur bedienbar und ohne JavaScript nutzbar; das Skript ergänzt Escape,
// Schließen bei Klick außerhalb und den Fokus zurück auf den Knopf. Alle Kurse: im Fuß und unter /kurse/.
import { ANFRAGE_PFAD, MENUE } from '../lib/site';
import { href } from '../lib/pfad';

const pfad = Astro.url.pathname;
const istAktiv = (p: string) => (pfad === href(p) || (p !== '/' && pfad.startsWith(href(p))));
---

<header class="sticky top-0 z-50 border-b border-base-300/70 bg-base-100/95 backdrop-blur supports-[backdrop-filter]:bg-base-100/85">
  <div class="rahmen flex h-[4.5rem] items-center justify-between gap-4">
    <a href={href('/')} class="flex shrink-0 items-center rounded-md" aria-label="waybuild Akademie – zur Startseite">
      <img src={href('/logo/waybuild-akademie.svg')} alt="waybuild Akademie" width="1357" height="447" class="h-9 w-auto min-[400px]:h-11 sm:h-12" />
    </a>

    <nav aria-label="Hauptmenü" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[0.95rem] font-medium">
        {
          MENUE.map((m) => (
            <li>
              <a
                href={href(m.pfad)}
                aria-current={istAktiv(m.pfad) ? 'page' : undefined}
                class="relative inline-flex min-h-11 items-center rounded-full px-3.5 text-navy transition-colors hover:bg-base-200 aria-[current=page]:bg-navy aria-[current=page]:text-white"
              >
                {m.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={href(ANFRAGE_PFAD)} class="btn btn-accent -mr-2 ml-auto min-h-11 rounded-full px-3.5 sm:px-5 lg:ml-0 lg:mr-0" data-kopf-anfrage>Anfragen</a>
    <details class="menue-mobil lg:hidden" data-menue>
      <summary
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 rounded-full border border-base-300 bg-white px-3 font-medium min-[400px]:px-4 text-navy [&::-webkit-details-marker]:hidden"
        aria-controls="menue-mobil-liste"
      >
        <span class="menue-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="menue-text-zu max-[399px]:sr-only">Menü</span>
        <span class="menue-text-auf max-[399px]:sr-only">Schließen</span>
      </summary>
      <nav aria-label="Hauptmenü mobil" id="menue-mobil-liste" class="absolute inset-x-0 top-full max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-b border-base-300 bg-base-100 shadow-[0_24px_40px_-24px_rgba(0,52,107,0.35)]">
        <ul class="rahmen grid gap-1 py-4">
          {
            MENUE.map((m) => (
              <li>
                <a
                  href={href(m.pfad)}
                  aria-current={istAktiv(m.pfad) ? 'page' : undefined}
                  class="flex min-h-12 items-center justify-between rounded-xl px-4 font-serif text-xl text-navy hover:bg-base-200 aria-[current=page]:bg-navy aria-[current=page]:text-white"
                >
                  {m.name}
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5 opacity-60"><path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </li>
            ))
          }
          <li>
            <a href={href('/kurse/')} class="flex min-h-12 items-center rounded-xl px-4 text-navy hover:bg-base-200">Alle Kurse</a>
          </li>
          <li class="mt-2">
            <a href={href(ANFRAGE_PFAD)} class="btn btn-accent w-full rounded-full text-base" data-kopf-anfrage-menue>Kurs anfragen</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .menue-icon {
    display: inline-grid;
    gap: 4px;
    width: 18px;
  }
  .menue-icon span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menue-text-auf {
    display: none;
  }
  details[open] .menue-text-zu {
    display: none;
  }
  details[open] .menue-text-auf {
    display: inline;
  }
  details[open] .menue-icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  details[open] .menue-icon span:nth-child(2) {
    opacity: 0;
  }
  details[open] .menue-icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  // Loop 21.11.: „Anfragen“ im Kopf behält den Zusammenhang der Seite – Kursseite → deren Buchungsanfrage (Kurs vorausgewählt),
  // Seite mit eigener Kurzanfrage (Berufsseite) → dortiges Formular. Ohne JavaScript bleibt es bei /#anfrage.
  {
    const ziel =
      document.querySelector<HTMLAnchorElement>('a[data-hauptaktion="anfrage"], a[data-hauptaktion="coaching"], a[data-coaching-anfrage]')?.getAttribute('href') ??
      (document.querySelector('form[data-anfrage-formular]#anfrage') ? '#anfrage' : null);
    if (ziel)
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-kopf-anfrage], a[data-kopf-anfrage-menue]')) {
        a.setAttribute('href', ziel);
        // Sprung zum Formular auf derselben Seite: Fokus ins Namensfeld (Loop R9)
        if (ziel === '#anfrage') a.addEventListener('click', () => setTimeout(() => (document.querySelector<HTMLElement>('#anfrage :is(select, input)[required]:invalid') ?? document.getElementById('anfrage-name'))?.focus({ preventScroll: true }), 0));
      }
  }
  const menue = document.querySelector<HTMLDetailsElement>('[data-menue]');
  if (menue) {
    const knopf = menue.querySelector('summary');
    // Sprung auf derselben Seite (#anfrage): Menü schließen, sonst verdeckt es das Formular (QA R6)
    menue.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menue.open = false;
    });
    const schliessen = (fokus: boolean) => {
      if (!menue.open) return;
      menue.open = false;
      if (fokus) knopf?.focus();
    };
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') schliessen(true);
    });
    document.addEventListener('click', (e) => {
      if (menue.open && !menue.contains(e.target as Node)) schliessen(false);
    });
    // Bei Wechsel auf Desktop-Breite Menü schließen
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && schliessen(false));
  }

</script>

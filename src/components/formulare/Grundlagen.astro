---
// Gemeinsame Teile jedes Formulars: Demo-Hinweis (Vorschau), Fehler-Zusammenfassung, allgemeine Meldung,
// Lockfeld (Honeypot) und Zeitstempel-Felder (Zeitfalle) sowie die Formular-Stile.
import { IS_PREVIEW } from '../../lib/env';
import { AKADEMIE } from '../../lib/site';

interface Props {
  form: string;
}
const { form } = Astro.props;
---

{
  IS_PREVIEW && (
    <div class="flex gap-3 rounded-2xl border border-bernstein bg-bernstein/15 p-4 text-sm" data-demo-hinweis>
      <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-bernstein font-bold text-navy" aria-hidden="true">i</span>
      <p>
        <strong>Demo-Modus:</strong> In dieser Vorschau wird nichts gesendet. Du kannst das Formular ausprobieren – nach dem Absenden
        siehst du die Bestätigungsseite.
      </p>
    </div>
  )
}

<div id={`${form}-summary`} class="fehler-summary rounded-2xl border-2 border-error bg-white p-5" tabindex="-1" data-fehler-summary hidden>
  <h2 class="font-sans text-lg font-semibold text-error" data-summary-titel>Bitte prüfe deine Angaben</h2>
  <ul class="mt-2 grid list-disc gap-1 pl-5" data-summary-liste></ul>
</div>

<div class="rounded-2xl border-2 border-error bg-white p-5" role="alert" data-formular-meldung hidden>
  <p class="font-semibold text-error" data-meldung-text></p>
  <p class="mt-1 text-sm">
    Du erreichst uns auch per E-Mail:
    <a class="link-fliess" href={`mailto:${form === 'interesse' || form === 'kontakt' ? AKADEMIE.mailInfo : AKADEMIE.mailAnmeldung}`}>
      {form === 'interesse' || form === 'kontakt' ? AKADEMIE.mailInfo : AKADEMIE.mailAnmeldung}
    </a>
  </p>
</div>

<!-- Lockfeld: für Menschen unsichtbar, Programme füllen es aus -->
<div class="lockfeld" aria-hidden="true">
  <label for={`${form}-website`}>Website (bitte leer lassen)</label>
  <input id={`${form}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
</div>
<input type="hidden" name="ts" value="" data-zeit-ts />
<input type="hidden" name="sig" value="" data-zeit-sig />

<style is:global>
  .lockfeld {
    position: absolute !important;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .feld-fehler {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    color: var(--color-error);
    font-size: 0.925rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .feld-fehler[hidden],
  [data-fehler-summary][hidden],
  [data-formular-meldung][hidden] {
    display: none;
  }
  .feld-fehler::before {
    content: '!';
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: var(--color-error);
    color: #fff;
    font-size: 0.75rem;
  }
  .formular .input,
  .formular .select,
  .formular .textarea {
    background: #fff;
    border-color: var(--color-base-300);
    min-height: 3rem;
  }
  .formular .input:focus,
  .formular .select:focus,
  .formular .textarea:focus {
    border-color: var(--color-petrol);
    outline: 3px solid color-mix(in oklab, var(--color-petrol) 35%, transparent);
    outline-offset: 0;
  }
  .formular fieldset[disabled],
  .formular [data-bereich][hidden] {
    display: none;
  }
  .formular .wahlkarte {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    min-height: 3.25rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-base-300);
    cursor: pointer;
    transition: box-shadow 0.15s;
  }
  .formular .wahlkarte:has(input:checked) {
    box-shadow: inset 0 0 0 2px var(--color-navy);
    background: color-mix(in oklab, var(--color-petrol) 6%, #fff);
  }
  .formular .wahlkarte:has(input:focus-visible) {
    outline: 3px solid var(--color-petrol);
    outline-offset: 2px;
  }
</style>

---
// Kontakt- und Beratungsanfrage (US-16): Name, E-Mail, optional Telefon, Thema, Nachricht, Einwilligung → /api/kontakt.php → info@.
import Feld from './Feld.astro';
import Haken from './Haken.astro';
import Grundlagen from './Grundlagen.astro';
import { FEHLER, KONTAKT_THEMEN } from '../../lib/formular';
import { IS_PREVIEW } from '../../lib/env';
import { href } from '../../lib/pfad';

const F = 'kontakt';
---

<form
  id={F}
  class="formular grid gap-6 rounded-[1.5rem] bg-white p-5 ring-1 ring-base-300 sm:p-8"
  method="post"
  action={href('/api/kontakt.php')}
  accept-charset="utf-8"
  data-einfaches-formular
  data-art="kontakt"
  data-demo={IS_PREVIEW ? 'true' : 'false'}
  data-danke={href('/danke/')}
  data-token={href('/api/token.php')}
>
  <Grundlagen form={F} />
  <div class="grid gap-5 sm:grid-cols-2">
    <Feld form={F} name="name" label="Name" pflicht nativ min={2} max={100} fehler={FEHLER.name} autocomplete="name" zusatz={{ 'data-zeile': 'Name' }} />
    <Feld form={F} name="email" label="E-Mail" typ="email" pflicht nativ regel="email" max={254} fehler={FEHLER.email} autocomplete="email" inputmode="email" zusatz={{ 'data-zeile': 'E-Mail' }} />
    <Feld form={F} name="telefon" label="Telefon" typ="tel" regel="telefon" fehler={FEHLER.telefon} autocomplete="tel" inputmode="tel" hinweis="Wenn du lieber zurückgerufen werden möchtest." />
    <Feld form={F} name="thema" label="Worum geht es?" typ="select" pflicht nativ fehler={FEHLER.thema} zusatz={{ 'data-url-param': 'thema', 'data-zeile': 'Thema' }}>
      <option value="">Bitte Thema wählen</option>
      {KONTAKT_THEMEN.map((t) => <option value={t.id}>{t.name}</option>)}
    </Feld>
  </div>
  <Feld form={F} name="nachricht" label="Deine Nachricht" typ="textarea" pflicht nativ min={10} max={2000} zeilen={6} fehler={FEHLER.kontaktNachricht} />
  <Haken form={F} name="einwilligung" pflicht nativ fehler={FEHLER.einwilligungKontakt}>
    Ihr dürft meine Angaben nutzen, um meine Anfrage zu beantworten. Mehr dazu in der{' '}
    <a class="link-fliess" href={href('/datenschutz/')} target="_blank">Datenschutzerklärung</a>.
  </Haken>
  <div class="flex flex-wrap items-center gap-4 border-t border-base-300 pt-6">
    <button type="submit" class="btn btn-accent btn-lg rounded-full px-8" data-absenden>Nachricht senden</button>
    <p class="text-sm text-gedaempft">Wir antworten in der Regel innerhalb von zwei Werktagen.</p>
  </div>
</form>

<script>
  import './einfach-client';
</script>

---
// Station 4: Abreißkalender blättert bis zum echten nächsten Prüfungstag (aus den Kursterminen), „Noch N Tage“.
import type { ReiseWerte } from './reise';
interface Props { w: ReiseWerte }
const { w } = Astro.props;
---

<svg viewBox="0 0 480 360" class="hr-svg" aria-hidden="true" focusable="false">
  <circle cx="70" cy="290" r="100" fill="#0079a6" opacity=".07" />
  <circle cx="430" cy="40" r="80" fill="#f2a900" opacity=".14" />

  <g transform="translate(140 36)">
    <rect x="8" y="30" width="196" height="262" rx="16" fill="#00346b" opacity=".1" />
    <!-- Endblatt: Prüfungstag -->
    <g>
      <rect y="20" width="196" height="262" rx="16" fill="#ffffff" />
      <path d="M0 36a16 16 0 0 1 16-16h164a16 16 0 0 1 16 16v38H0z" fill="#0079a6" />
      <text x="98" y="54" text-anchor="middle" font-size="15" font-weight="650" fill="#ffffff" class="hr-sans" data-hr-f="monat">{w.monat}</text>
      <text x="98" y="188" text-anchor="middle" class="hr-serif s4-zahl" font-size="112" fill="#00346b" data-hr-f="tag">{w.tag}</text>
      <text x="98" y="222" text-anchor="middle" font-size="14" fill="#545454" class="hr-sans" data-hr-f="wochentag">{w.wochentag}</text>
      <path d="M24 240h148" stroke="#e5dfd3" stroke-width="1.5" />
      <text x="98" y="264" text-anchor="middle" font-size="13" font-weight="700" fill="#006b68" class="hr-sans" data-hr-f="pruefungTitel">{w.pruefungTitel}</text>
      <path class="s4-kreis" d="M26 162C16 120 70 96 112 98c48 2 72 30 60 62-12 32-62 42-102 36-30-5-46-20-42-46" fill="none" stroke="#f2a900" stroke-width="5" stroke-linecap="round" pathLength="1" />
    </g>
    <!-- Vorblätter (nur in der Animation sichtbar) -->
    {
      [w.vortag, w.vorvortag].map((t, i) => (
        <g class={`s4-blatt s4-blatt${i + 1}`}>
          <rect y="20" width="196" height="262" rx="16" fill="#ffffff" stroke="#e5dfd3" stroke-width="1.5" />
          <path d="M0 36a16 16 0 0 1 16-16h164a16 16 0 0 1 16 16v38H0z" fill="#0079a6" />
          <text x="98" y="188" text-anchor="middle" class="hr-serif" font-size="112" fill="#c9c1b3" data-hr-f={i === 0 ? 'vortag' : 'vorvortag'}>{t}</text>
        </g>
      ))
    }
    <g fill="#00346b"><rect x="46" y="6" width="12" height="30" rx="6" /><rect x="138" y="6" width="12" height="30" rx="6" /></g>
  </g>

  {w.iso && (<g transform="translate(372 96)">
    <g class="s4-plakette">
      <circle r="54" fill="#00346b" />
      <circle r="46" fill="none" stroke="#f2a900" stroke-width="2" stroke-dasharray="3 5" />
      <text y="-17" text-anchor="middle" font-size="13" fill="#ffffff" class="hr-sans">Noch</text>
      <text y="17" text-anchor="middle" font-size="34" fill="#ffffff" class="hr-serif" data-hr-f="tage">{w.tage}</text>
      <text y="36" text-anchor="middle" font-size="13" fill="#ffffff" class="hr-sans" data-hr-f="einheit">{w.einheit}</text>
    </g>
  </g>)}
</svg>

<style>
  .s4-blatt { opacity: 0; }
  .s4-zahl { font-variation-settings: 'opsz' 144; }
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    :global(.hr-station.ist-aktiv) .s4-blatt {
      animation: s4-abreissen 0.7s cubic-bezier(0.5, 0, 0.75, 0.4) both;
      transform-box: fill-box;
      transform-origin: 20% 0;
    }
    :global(.hr-station.ist-aktiv) .s4-blatt2 { animation-delay: 0.35s; }
    :global(.hr-station.ist-aktiv) .s4-blatt1 { animation-delay: 0.95s; }
    :global(.hr-station.ist-aktiv) .s4-kreis {
      stroke-dasharray: 1;
      animation: s4-zeichnen 0.7s ease-in-out 1.75s both;
    }
    :global(.hr-station.ist-aktiv) .s4-plakette {
      animation: s4-pop 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) 2.15s both;
      transform-box: fill-box;
      transform-origin: center;
    }
  }
  @keyframes s4-abreissen {
    0%, 15% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translate(60px, 220px) rotate(28deg); }
  }
  @keyframes s4-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes s4-pop { from { opacity: 0; transform: scale(0.3) rotate(-20deg); } }
</style>

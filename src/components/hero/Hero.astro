---
// Hero der Startseite: links die Kernbotschaft mit den Knöpfen, rechts die Reise-Bühne (Anmeldung → Abschluss),
// darunter der Prüfungs-Countdown als ruhiges Band. Alle Termine kommen aus den Kursdaten (Props), nichts fest eingetragen.
// Rechtlich: kein „garantiert bestehen“, keine Quoten; nur Live-Unterricht; Endpreise ohne USt-Zusatz.
import Countdown from '../Countdown.astro';
import ReiseBuehne from './ReiseBuehne.astro';
import { reiseWerte } from './reise';
import type { CountdownOption } from '../../lib/countdown';
import type { Kurs } from '../../lib/kurse';
import { href } from '../../lib/pfad';

interface Props {
  countdown: CountdownOption[];
  kurse: Kurs[];
}
const { countdown, kurse } = Astro.props;
// Je Kurs der erste und alle späteren buchbaren Termine – der Browser nimmt den ersten mit offenem Anmeldeschluss
const reise = countdown.map((o) => ({ ...reiseWerte(o, kurse), folge: o.weitere.map((w) => reiseWerte(w, kurse)) }));
const VORTEILE = ['Dozenten mit IHK-Prüfer-Erfahrung', 'Rechnung an dich oder deinen Betrieb', 'Keine Online-Zahlung'];
---

<section class="hero-start relative isolate overflow-hidden" aria-labelledby="hero-titel">
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="rahmen grid items-start gap-8 pt-8 pb-10 sm:pt-12 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-12 lg:pt-14 lg:pb-12 xl:gap-16">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold ring-1 ring-base-300">
        <span class="relative flex size-2.5" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-bernstein opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex size-2.5 rounded-full bg-bernstein"></span>
        </span>
        Alle Kurse live online
      </p>
      <h1 id="hero-titel" class="mt-5 text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-[3.3rem] xl:text-[3.7rem]">
        <span class="block">Live lernen.</span>
        <span class="block text-petrol">Gut vorbereitet in die Prüfung.</span>
        <span class="block">Weiter im Beruf.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-gedaempft sm:text-xl">
        IHK-Prüfungsvorbereitung für IT-Azubis und Umschüler – live online, abends, mit festen Terminen und klaren Endpreisen. Von der Anmeldung bis zum Prüfungstag weißt du, was als Nächstes kommt.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={href('/kurse/')} class="btn btn-accent btn-lg rounded-full px-7" data-hero-buchen>Kurs &amp; Termin wählen</a>
        <a href={href('/termine/')} class="btn btn-outline btn-secondary btn-lg rounded-full px-7">Alle Termine</a>
      </div>
      <ul class="mt-8 grid gap-2 text-[0.95rem] sm:flex sm:flex-wrap sm:gap-x-6">
        {
          VORTEILE.map((t) => (
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 20 20" class="size-5 shrink-0 text-tief" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {t}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hero-buehne">
      <ReiseBuehne optionen={reise} />
    </div>
  </div>
  {
    countdown.length > 0 && (
      <div class="rahmen pb-14 sm:pb-20">
        <div class="hero-cd">
          <Countdown optionen={countdown} />
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-aura {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38rem 30rem at 88% 18%, rgb(0 121 166 / 0.16), transparent 70%),
      radial-gradient(30rem 26rem at 62% 78%, rgb(242 169 0 / 0.13), transparent 70%),
      radial-gradient(26rem 22rem at 8% 0%, rgb(0 107 104 / 0.07), transparent 70%);
  }
  .hero-aura::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(0 52 107 / 0.09) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(60% 70% at 75% 40%, #000, transparent 75%);
  }
  @media (min-width: 80rem) {
    .hero-buehne { margin-right: -2rem; }
  }
</style>

<style is:global>
  /* Countdown als waagerechtes Band unter der Bühne (ab 64rem). Das Bauteil bleibt unverändert;
     Sichtbarkeit der Tafeln regelt weiter dessen :has-Logik (höhere Spezifität blendet aus). */
  @media (min-width: 64rem) {
    .hero-cd .cd-box { padding: 1.5rem 2rem; }
    .hero-cd .cd-box .cd-tafel[data-cd-tafel='0'],
    .hero-cd .cd-box:has(.cd-schalter label:nth-of-type(2) input:checked) .cd-tafel[data-cd-tafel='1'],
    .hero-cd .cd-box:has(.cd-schalter label:nth-of-type(3) input:checked) .cd-tafel[data-cd-tafel='2'],
    .hero-cd .cd-box:has(.cd-schalter label:nth-of-type(4) input:checked) .cd-tafel[data-cd-tafel='3'] {
      display: grid;
      grid-template-columns: auto minmax(12rem, 1fr) auto;
      column-gap: 2.5rem;
      align-items: center;
    }
    .hero-cd .cd-tafel > p:first-child { grid-row: 1 / 3; }
    .hero-cd .cd-zahl { font-size: 5rem; }
    .hero-cd .cd-strahl { grid-column: 2; grid-row: 1; align-self: end; margin-top: 0; }
    .hero-cd .cd-legende { grid-column: 2; grid-row: 2; align-self: start; margin-top: 0.5rem; }
    .hero-cd .cd-start { grid-column: 3; grid-row: 1 / 3; margin-top: 0; }
    .hero-cd .cd-start span span:last-child { white-space: nowrap; }
    .hero-cd .cd-tafel > p:not(:first-child) { grid-column: 1 / -1; grid-row: 3; margin-top: 0.75rem; }
  }
</style>

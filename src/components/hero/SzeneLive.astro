---
// Station 3: Live-Unterricht am Abend – Laptop mit Videokacheln, Uhrzeit aus den Kurszeiten,
// Übungsaufgaben werden abgehakt („gemeinsam live besprochen“).
import type { ReiseWerte } from './reise';
interface Props { w: ReiseWerte }
const { w } = Astro.props;
const KACHELN = [
  { x: 102, y: 88, farbe: '#0079a6' },
  { x: 198, y: 88, farbe: '#006b68' },
  { x: 102, y: 170, farbe: '#00346b' },
  { x: 198, y: 170, farbe: '#545454' },
];
const STERNE = [[40, 92, 1.6], [96, 40, 1.2], [180, 30, 1.4], [300, 46, 1], [440, 120, 1.5], [24, 200, 1.1], [456, 222, 1.2]];
---

<svg viewBox="0 0 480 360" class="hr-svg" aria-hidden="true" focusable="false">
  <g fill="#ffffff">{STERNE.map(([x, y, r], i) => <circle class="s3-stern" style={`--i:${i}`} cx={x} cy={y} r={r} opacity=".6" />)}</g>
  <path d="M424 30a22 22 0 1 0 20 30a17 17 0 0 1-20-30z" fill="#f2a900" />

  <g transform="translate(24 22)">
    <rect width="128" height="36" rx="18" fill="#ffffff" />
    <circle cx="20" cy="18" r="9" fill="none" stroke="#0079a6" stroke-width="2.2" />
    <path d="M20 13v5l3.5 2.5" fill="none" stroke="#0079a6" stroke-width="2.2" stroke-linecap="round" />
    <text x="36" y="23.5" font-size="14" font-weight="700" fill="#00346b" class="hr-sans" data-hr-f="uhr">{w.uhr}</text>
  </g>

  <!-- Laptop -->
  <rect x="84" y="70" width="312" height="196" rx="14" fill="#c9d6e2" />
  <rect x="94" y="80" width="292" height="176" rx="7" fill="#faf8f4" />
  <path d="M56 266h368l-20 20H76z" fill="#9fb3c6" />
  <rect x="210" y="266" width="60" height="6" rx="3" fill="#7f97ad" />

  {
    KACHELN.map((k, i) => (
      <g class={`s3-kachel s3-k${i + 1}`}>
        <rect x={k.x} y={k.y} width="90" height="76" rx="6" fill={k.farbe} />
        <circle cx={k.x + 45} cy={k.y + 32} r="11" fill="#faf8f4" />
        <path d={`M${k.x + 25} ${k.y + 76}c0-14 9-20 20-20s20 6 20 20`} fill="#faf8f4" />
      </g>
    ))
  }
  <rect class="s3-spricht" x="102" y="88" width="90" height="76" rx="6" fill="none" stroke="#f2a900" stroke-width="3.5" />
  <g transform="translate(108 94)">
    <rect width="38" height="15" rx="7.5" fill="#f2a900" />
    <circle class="s3-puls" cx="8" cy="7.5" r="3" fill="#00346b" />
    <text x="14" y="11" font-size="9" font-weight="800" fill="#00346b" class="hr-sans">LIVE</text>
  </g>

  <!-- Übungsaufgaben -->
  <text x="298" y="102" font-size="10.5" font-weight="700" fill="#00346b" class="hr-sans">Aufgaben</text>
  {
    [0, 1, 2].map((z) => (
      <g>
        <rect x="298" y={116 + z * 40} width="16" height="16" rx="4" fill="#ffffff" stroke="#0079a6" stroke-width="2" />
        <rect x="320" y={118 + z * 40} width={[54, 44, 50][z]} height="5" rx="2.5" fill="#e5dfd3" />
        <rect x="320" y={127 + z * 40} width={[36, 46, 30][z]} height="4" rx="2" fill="#efeae1" />
        <path class={`s3-haken s3-h${z + 1}`} d={`M301.5 ${124 + z * 40}l4 4 7.5-8.5`} fill="none" stroke="#006b68" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
      </g>
    ))
  }

  <g transform="translate(240 320)">
    <g class="s3-pille">
      <rect x="-136" y="-19" width="272" height="38" rx="19" fill="#ffffff" fill-opacity=".1" stroke="#ffffff" stroke-opacity=".35" stroke-width="1.5" />
      <circle cx="-112" cy="0" r="10" fill="#f2a900" />
      <path d="M-117 0l3.5 3.5 6.5-7" fill="none" stroke="#00346b" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      <text x="-94" y="5" font-size="14" font-weight="650" fill="#ffffff" class="hr-sans">gemeinsam live besprochen</text>
    </g>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    :global(.hr-station.ist-aktiv) .s3-kachel {
      animation: s3-auf 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      transform-box: fill-box;
      transform-origin: center;
    }
    :global(.hr-station.ist-aktiv) .s3-k2 { animation-delay: 0.15s; }
    :global(.hr-station.ist-aktiv) .s3-k3 { animation-delay: 0.3s; }
    :global(.hr-station.ist-aktiv) .s3-k4 { animation-delay: 0.45s; }
    :global(.hr-station.ist-aktiv) .s3-spricht { animation: s3-sprechen 1.4s ease-in-out 0.6s infinite both; }
    :global(.hr-station.ist-aktiv) .s3-puls {
      animation: s3-puls 1.1s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    :global(.hr-station.ist-aktiv) .s3-stern { animation: s3-funkeln 2.4s ease-in-out calc(var(--i) * 0.3s) infinite; }
    :global(.hr-station.ist-aktiv) .s3-haken {
      stroke-dasharray: 1;
      animation: s3-zeichnen 0.4s ease-out both;
    }
    :global(.hr-station.ist-aktiv) .s3-h1 { animation-delay: 0.9s; }
    :global(.hr-station.ist-aktiv) .s3-h2 { animation-delay: 1.5s; }
    :global(.hr-station.ist-aktiv) .s3-h3 { animation-delay: 2.1s; }
    :global(.hr-station.ist-aktiv) .s3-pille { animation: s3-hoch 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 2.5s both; }
  }
  @keyframes s3-auf { from { opacity: 0; transform: scale(0.7); } }
  @keyframes s3-sprechen { 50% { stroke-opacity: 0.25; } }
  @keyframes s3-puls { 50% { transform: scale(0.55); } }
  @keyframes s3-funkeln { 50% { opacity: 0.15; } }
  @keyframes s3-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes s3-hoch { from { opacity: 0; transform: translateY(16px); } }
</style>

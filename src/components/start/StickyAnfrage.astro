---
// Feste Leiste mobil (Can #6771): „Unverbindlich anfragen“ immer in Daumennähe; verschwindet, sobald das Formular im Blick ist.
// Ab 1024 px übernimmt der Knopf „Anfragen“ im Kopf. Der Abstandhalter verhindert, dass die Leiste den Fuß verdeckt.
interface Props {
  bereich?: string;
}
const { bereich } = Astro.props;
---

<div class="h-20 lg:hidden" aria-hidden="true"></div>
<div class="sticky-anfrage fixed inset-x-0 bottom-0 z-40 border-t border-base-300 bg-base-100/95 p-3 backdrop-blur lg:hidden" data-sticky-anfrage>
  <a href="#anfrage" class="btn btn-accent btn-lg w-full rounded-full text-base" data-anfrage-bereich={bereich}>Unverbindlich anfragen</a>
</div>

<script>
  const leiste = document.querySelector<HTMLElement>('[data-sticky-anfrage]');
  const form = document.querySelector('[data-anfrage-formular]');
  // Loop R11 (MKT-019): erst nach etwa einer Bildschirmhöhe einblenden – oben stehen Kopf- und Hero-Knopf schon im Blick.
  if (leiste && form && 'IntersectionObserver' in window) {
    let formSichtbar = false;
    const pruefen = () => {
      leiste.hidden = formSichtbar || window.scrollY < window.innerHeight * 0.9;
    };
    new IntersectionObserver((es) => {
      formSichtbar = es[0].isIntersecting;
      pruefen();
    }, { rootMargin: '0px 0px -10% 0px' }).observe(form);
    window.addEventListener('scroll', pruefen, { passive: true });
    pruefen();
  }
</script>

---
// Fuß: IHK-Hinweis (US-19, wörtlich), Menü, Rechtslinks (US-20, ein Klick von jeder Seite), allgemeine Mail.
import { AKADEMIE, IHK_HINWEIS, MENUE, RECHTLICHES } from '../lib/site';
import { href } from '../lib/pfad';

const jahr = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="rahmen pt-14 pb-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-md">
        <a href={href('/')} class="inline-flex items-center gap-3 rounded-md" aria-label="waybuild Akademie – zur Startseite">
          <img src={href('/logo/waybuild-akademie-zeichen-hell.svg')} alt="" width="665" height="447" class="h-10 w-auto" />
          <span class="font-serif text-2xl leading-none">Akademie</span>
        </a>
        <p class="mt-5 text-white/85">
          Live-Online-Kurse für deine IHK-Prüfung und deinen nächsten Schritt im Beruf – mit festen Terminen und klaren Preisen.
        </p>
        <p class="mt-5">
          <span class="block text-sm text-white/70">Fragen? Schreib uns:</span>
          <a href={`mailto:${AKADEMIE.mailInfo}`} class="text-lg font-semibold text-white underline decoration-bernstein decoration-2 underline-offset-4 hover:decoration-4">{AKADEMIE.mailInfo}</a>
        </p>
      </div>

      <nav aria-label="Angebot">
        <h2 class="font-sans text-sm font-semibold text-white/70">Angebot</h2>
        <ul class="mt-3 grid gap-1">
          {
            MENUE.map((m) => (
              <li>
                <a href={href(m.pfad)} class="inline-flex min-h-10 items-center text-white hover:underline">{m.name}</a>
              </li>
            ))
          }
          <li><a href={href('/faq/')} class="inline-flex min-h-10 items-center text-white hover:underline">Häufige Fragen</a></li>
        </ul>
      </nav>

      <nav aria-label="Rechtliches">
        <h2 class="font-sans text-sm font-semibold text-white/70">Rechtliches</h2>
        <ul class="mt-3 grid gap-1">
          {
            RECHTLICHES.map((m) => (
              <li>
                <a href={href(m.pfad)} class="inline-flex min-h-10 items-center text-white hover:underline">{m.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-12 rounded-2xl border border-white/20 bg-white/5 p-5 text-sm leading-relaxed text-white/90" data-ihk-hinweis>
      {IHK_HINWEIS}
    </p>
    <p class="mt-6 text-sm text-white/70">© {jahr} waybuild Akademie · Alle Kurse finden live online statt.</p>
  </div>
</footer>

---
// „Warum du bei uns gut vorbereitet in die Prüfung gehst“ – kurze animierte Bühne mit sechs Szenen (Can, 13.11.2026).
// Startseite und später /pruefungsvorbereitung/ nutzen dieselbe Komponente.
// - Reine SVG/CSS-Grafiken, kein externes Asset; kleines Skript nur für Abspielen/Pause/Weiter/Punkte.
// - Autoplay nur, wenn die Bühne sichtbar ist; Pause-Knopf (WCAG 2.2.2); Öffnen von „Mehr erfahren“ hält an.
// - Ohne JavaScript und bei reduzierter Bewegung: alle Szenen als statische Bildfolge (Endzustand der Grafik).
// Rechtlich: kein Erfolgsversprechen, keine Quoten, keine Namen – nur „Dozenten mit IHK-Prüfer-Erfahrung“;
// rein synchroner Live-Unterricht (keine Aufzeichnungen/Selbststudium erwähnen).
import { href } from '../lib/pfad';

interface Props {
  /** Überschrift der Bühne */
  titel?: string;
  /** Knopf „Kurs & Termin wählen“ */
  buchenUrl?: string;
  /** optional: zweiter Knopf zum nächsten Termin */
  naechster?: { text: string; url: string };
  id?: string;
}
const {
  titel = 'Warum du bei uns gut vorbereitet in die Prüfung gehst',
  buchenUrl = href('/kurse/'),
  naechster,
  id = 'warum',
} = Astro.props;

const SZENEN = [
  {
    titel: 'Live online – abends, von zu Hause',
    mehr: 'Du lernst in einer festen Gruppe per Videokonferenz – zweimal pro Woche ab 18:00 Uhr, ohne Anfahrt. Jeder Termin ist Live-Unterricht.',
  },
  {
    titel: 'Dozenten mit IHK-Prüfer-Erfahrung',
    mehr: 'Bei uns unterrichten erfahrene IHK-Prüfer und Dozenten mit langjähriger Praxis. Sie kennen die Prüfung von der anderen Seite und wissen, worauf es bei nachvollziehbaren Antworten ankommt.',
  },
  {
    titel: 'Prüfungsnahe Aufgaben, gemeinsam live',
    mehr: 'Jeder Abend hat ein Schwerpunktthema. Übungsaufgaben im Stil der Abschlussprüfung besprechen wir gemeinsam live – mit Lösungsweg und typischen Fehlern.',
  },
  {
    titel: 'Ein klarer Plan bis zur Prüfung',
    mehr: 'Die Kursabende sind auf den bundesweiten Prüfungstermin abgestimmt und enden kurz davor. So wiederholst du die Themen in einer sinnvollen Reihenfolge.',
  },
  {
    titel: 'Fragen klärst du direkt live',
    mehr: 'Per Mikrofon oder Chat fragst du, sobald etwas unklar ist. Abend verpasst? Du holst ihn in einem späteren Live-Termin nach.',
  },
  {
    titel: 'Gut vorbereitet in den Prüfungstag',
    mehr: 'Du verstehst die Zusammenhänge, statt Lösungen auswendig zu lernen. Die Prüfung legst du bei deiner IHK ab – verbindlich ist deren Einladung.',
  },
];
const n = SZENEN.length;
---

<section class="wb" aria-labelledby={`${id}-titel`} data-warum id={id}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id={`${id}-titel`} class="max-w-2xl text-3xl sm:text-4xl">{titel}</h2>
    <div class="wb-steuerung hidden items-center gap-2" data-wb-steuerung>
      <button type="button" class="wb-knopf" data-wb-zurueck aria-label="Vorherige Szene">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="wb-knopf wb-knopf--pause" data-wb-pause aria-label="Animation anhalten">
        <svg class="wb-ic-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14" /></svg>
        <svg class="wb-ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
      </button>
      <button type="button" class="wb-knopf" data-wb-weiter aria-label="Nächste Szene">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <ol class="wb-liste mt-8" data-wb-liste>
    {
      SZENEN.map((sz, i) => (
        <li class:list={['wb-szene', { 'ist-aktiv': i === 0 }]} data-wb-szene={i} aria-roledescription="Szene" aria-label={`${i + 1} von ${n}`}>
          <div class={`wb-bild wb-bild--${i + 1}`} aria-hidden="true">
            {i === 0 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#00346b" />
                <circle class="a-mond" cx="268" cy="44" r="16" fill="#f2a900" />
                <circle cx="275" cy="38" r="14" fill="#00346b" />
                <g fill="#ffffff" opacity=".55"><circle cx="40" cy="30" r="1.6" /><circle cx="92" cy="52" r="1.2" /><circle cx="210" cy="24" r="1.4" /><circle cx="160" cy="40" r="1" /></g>
                <rect x="56" y="62" width="208" height="122" rx="10" fill="#e5dfd3" />
                <rect x="64" y="70" width="192" height="106" rx="6" fill="#faf8f4" />
                <path d="M36 184h248l-14 14H50z" fill="#c9c1b3" />
                <g class="a-kachel a-k1"><rect x="72" y="78" width="84" height="44" rx="5" fill="#0079a6" /><circle cx="114" cy="96" r="8" fill="#faf8f4" /><path d="M100 122c0-10 6-14 14-14s14 4 14 14" fill="#faf8f4" /><rect x="72" y="78" width="84" height="44" rx="5" fill="none" stroke="#f2a900" stroke-width="3" /></g>
                <g class="a-kachel a-k2"><rect x="164" y="78" width="84" height="44" rx="5" fill="#006b68" /><circle cx="206" cy="96" r="8" fill="#faf8f4" /><path d="M192 122c0-10 6-14 14-14s14 4 14 14" fill="#faf8f4" /></g>
                <g class="a-kachel a-k3"><rect x="72" y="126" width="84" height="44" rx="5" fill="#00346b" /><circle cx="114" cy="144" r="8" fill="#faf8f4" /><path d="M100 170c0-10 6-14 14-14s14 4 14 14" fill="#faf8f4" /></g>
                <g class="a-kachel a-k4"><rect x="164" y="126" width="84" height="44" rx="5" fill="#545454" /><circle cx="206" cy="144" r="8" fill="#faf8f4" /><path d="M192 170c0-10 6-14 14-14s14 4 14 14" fill="#faf8f4" /></g>
                <g><rect x="22" y="18" width="78" height="28" rx="14" fill="#faf8f4" /><circle class="a-puls" cx="38" cy="32" r="5" fill="#f2a900" /><text x="50" y="37" font-size="14" font-weight="700" fill="#00346b" font-family="Inter Variable, sans-serif">18:00</text></g>
              </svg>
            )}
            {i === 1 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#f2eee6" />
                <g transform="rotate(-6 120 120)"><rect x="54" y="40" width="130" height="160" rx="8" fill="#ffffff" stroke="#e5dfd3" stroke-width="2" /><rect x="70" y="58" width="70" height="8" rx="4" fill="#00346b" /><g fill="#e5dfd3"><rect x="70" y="80" width="96" height="6" rx="3" /><rect x="70" y="96" width="80" height="6" rx="3" /><rect x="70" y="112" width="92" height="6" rx="3" /><rect x="70" y="128" width="70" height="6" rx="3" /><rect x="70" y="144" width="88" height="6" rx="3" /></g></g>
                <g><circle cx="212" cy="98" r="24" fill="#00346b" /><path d="M170 200c0-36 18-58 42-58s42 22 42 58z" fill="#00346b" /></g>
                <g class="a-abzeichen">
                  <path d="M226 150l-12 46 18-10 12 18 6-50z" fill="#006b68" />
                  <path d="M266 150l12 46-18-10-12 18-6-50z" fill="#0079a6" />
                  <circle cx="246" cy="144" r="30" fill="#f2a900" />
                  <circle cx="246" cy="144" r="23" fill="none" stroke="#00346b" stroke-width="2" stroke-dasharray="3 3" />
                  <path class="a-haken" d="M234 145l8 8 16-17" fill="none" stroke="#00346b" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
                </g>
              </svg>
            )}
            {i === 2 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#e3f0f5" />
                <rect x="70" y="22" width="180" height="182" rx="10" fill="#ffffff" stroke="#e5dfd3" stroke-width="2" />
                <rect x="88" y="40" width="90" height="10" rx="5" fill="#00346b" />
                <rect x="190" y="38" width="42" height="14" rx="7" fill="#f2a900" />
                {[0, 1, 2, 3].map((z) => (
                  <g>
                    <rect x="88" y={70 + z * 32} width="20" height="20" rx="5" fill="#faf8f4" stroke="#0079a6" stroke-width="2" />
                    <rect x="118" y={74 + z * 32} width={z % 2 ? 86 : 108} height="6" rx="3" fill="#e5dfd3" />
                    <rect x="118" y={84 + z * 32} width={z % 2 ? 60 : 72} height="5" rx="2.5" fill="#efeae1" />
                    <path class={`a-haken a-h${z + 1}`} d={`M92 ${80 + z * 32}l5 5 9-10`} fill="none" stroke="#006b68" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
                  </g>
                ))}
                <g class="a-stift"><path d="M262 150l-40 40-10 4 4-10 40-40z" fill="#00346b" /><path d="M256 144l6 6 6-6-6-6z" fill="#f2a900" /></g>
              </svg>
            )}
            {i === 3 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#f2eee6" />
                <rect x="28" y="34" width="264" height="150" rx="12" fill="#ffffff" stroke="#e5dfd3" stroke-width="2" />
                <rect x="28" y="34" width="264" height="30" rx="12" fill="#00346b" />
                <rect x="28" y="52" width="264" height="12" fill="#00346b" />
                <g font-family="Inter Variable, sans-serif" font-size="11" font-weight="600" fill="#ffffff"><text x="62" y="54">Di</text><text x="104" y="54">Do</text><text x="150" y="54">Di</text><text x="192" y="54">Do</text></g>
                {[0, 1, 2, 3, 4].map((w) =>
                  [0, 1, 2, 3].map((c) => (
                    <circle class="a-punkt" style={`--v:${w * 4 + c}`} cx={68 + c * 44} cy={82 + w * 20} r="6.5" fill="#0079a6" opacity={c > 1 && w > 2 ? 0.25 : 1} />
                  )),
                )}
                <g class="a-ziel"><path d="M252 74v86" stroke="#00346b" stroke-width="3" stroke-linecap="round" /><path d="M254 76h28l-8 10 8 10h-28z" fill="#f2a900" /><circle cx="252" cy="162" r="8" fill="#006b68" /></g>
              </svg>
            )}
            {i === 4 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#e3f0f5" />
                <g class="a-blase a-b1"><path d="M34 52h120a14 14 0 0 1 14 14v34a14 14 0 0 1-14 14H70l-18 16v-16H34a14 14 0 0 1-14-14V66a14 14 0 0 1 14-14z" fill="#ffffff" /><text x="40" y="94" font-size="30" font-weight="700" fill="#0079a6" font-family="Fraunces Variable, serif">?</text><rect x="66" y="74" width="80" height="7" rx="3.5" fill="#e5dfd3" /><rect x="66" y="88" width="56" height="7" rx="3.5" fill="#e5dfd3" /></g>
                <g class="a-blase a-b2"><path d="M166 112h120a14 14 0 0 1 14 14v40a14 14 0 0 1-14 14h-18v16l-18-16h-84a14 14 0 0 1-14-14v-40a14 14 0 0 1 14-14z" fill="#00346b" /><text x="268" y="160" font-size="30" font-weight="700" fill="#f2a900" font-family="Fraunces Variable, serif">!</text><rect x="168" y="132" width="88" height="7" rx="3.5" fill="#ffffff" opacity=".8" /><rect x="168" y="146" width="70" height="7" rx="3.5" fill="#ffffff" opacity=".8" /><rect x="168" y="160" width="80" height="7" rx="3.5" fill="#ffffff" opacity=".8" /></g>
                <g class="a-tippen" fill="#0079a6"><circle cx="196" cy="70" r="5" /><circle cx="214" cy="70" r="5" /><circle cx="232" cy="70" r="5" /></g>
              </svg>
            )}
            {i === 5 && (
              <svg viewBox="0 0 320 220">
                <rect width="320" height="220" rx="18" fill="#00346b" />
                <g fill="#f2a900" class="a-funken"><circle cx="70" cy="50" r="4" /><circle cx="250" cy="44" r="5" /><circle cx="270" cy="150" r="3.5" /><circle cx="52" cy="160" r="3" /><path d="M94 30l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" /><path d="M234 172l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" /></g>
                <rect x="100" y="40" width="120" height="140" rx="12" fill="#faf8f4" />
                <rect x="100" y="40" width="120" height="34" rx="12" fill="#0079a6" />
                <rect x="100" y="60" width="120" height="14" fill="#0079a6" />
                <circle cx="130" cy="40" r="5" fill="#00346b" /><circle cx="190" cy="40" r="5" fill="#00346b" />
                <text x="160" y="63" text-anchor="middle" font-size="13" font-weight="700" fill="#ffffff" font-family="Inter Variable, sans-serif">Prüfungstag</text>
                <g class="a-stempel"><circle cx="160" cy="128" r="34" fill="#f2a900" /><path class="a-haken" d="M144 128l11 11 22-24" fill="none" stroke="#00346b" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1" /></g>
              </svg>
            )}
          </div>
          <div class="wb-text">
            <p class="wb-zaehler text-sm font-semibold text-tief" aria-hidden="true">{i + 1} / {n}</p>
            <h3 class="mt-1 text-2xl sm:text-[1.75rem]">{sz.titel}</h3>
            <details class="wb-mehr mt-3">
              <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 font-semibold text-petrol">
                <svg viewBox="0 0 20 20" class="wb-mehr-ic size-4" aria-hidden="true"><path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Mehr erfahren<span class="sr-only">: {sz.titel}</span>
              </summary>
              <p class="mt-1 max-w-md text-gedaempft">{sz.mehr}</p>
            </details>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-6 hidden items-center gap-2" data-wb-punkte-wrap>
    {
      SZENEN.map((sz, i) => (
        <button type="button" class="wb-punkt" data-wb-punkt={i} aria-label={`Szene ${i + 1}: ${sz.titel}`} aria-current={i === 0 ? 'true' : undefined}>
          <span />
        </button>
      ))
    }
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a href={buchenUrl} class="btn btn-accent btn-lg rounded-full px-7" data-wb-buchen>Kurs & Termin wählen</a>
    {naechster && <a href={naechster.url} class="btn btn-ghost btn-lg h-auto min-h-12 max-w-full shrink whitespace-normal rounded-full px-5 py-2 text-navy">{naechster.text}</a>}
  </div>
</section>

<style>
  /* Statisch (ohne JS / reduzierte Bewegung): alle Szenen als Bildfolge */
  .wb-liste {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 40rem) {
    .wb-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .wb-liste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .wb-bild svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.125rem;
  }
  .wb-text {
    padding-top: 1rem;
  }
  .wb-mehr-ic {
    transition: transform 0.2s;
  }
  .wb-mehr[open] .wb-mehr-ic {
    transform: rotate(180deg);
  }
  .wb-mehr summary::-webkit-details-marker {
    display: none;
  }
  .wb-mehr summary {
    list-style: none;
  }

  /* Bühne (mit JS, ohne reduzierte Bewegung) */
  .wb.ist-buehne .wb-liste {
    grid-template-columns: minmax(0, 1fr);
  }
  .wb.ist-buehne .wb-szene {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }
  .wb.ist-buehne .wb-szene.ist-aktiv {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.45s ease;
  }
  @media (min-width: 48rem) {
    .wb.ist-buehne .wb-szene {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
    }
    .wb.ist-buehne .wb-text {
      padding-top: 0;
    }
    .wb.ist-buehne h3 {
      font-size: clamp(1.75rem, 3vw, 2.5rem);
    }
  }
  .wb.ist-buehne [data-wb-steuerung],
  .wb.ist-buehne [data-wb-punkte-wrap] {
    display: flex;
  }

  .wb-knopf {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-navy);
    box-shadow: inset 0 0 0 1px var(--color-base-300);
    cursor: pointer;
  }
  .wb-knopf:hover {
    background: var(--color-base-200);
  }
  .wb-knopf svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wb-knopf--pause {
    background: var(--color-navy);
    color: #fff;
  }
  .wb-knopf--pause:hover {
    background: var(--color-petrol);
  }
  .wb-ic-play {
    display: none;
  }
  .wb-ic-play path {
    fill: currentColor;
  }
  .wb.ist-pausiert .wb-ic-play {
    display: block;
  }
  .wb.ist-pausiert .wb-ic-pause {
    display: none;
  }

  .wb-punkt {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
  }
  .wb-punkt span {
    position: relative;
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-base-300);
    transition: width 0.3s ease;
  }
  .wb-punkt[aria-current='true'] span {
    width: 2.25rem;
    background: color-mix(in srgb, var(--color-petrol) 25%, transparent);
  }
  .wb-punkt[aria-current='true'] span::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-petrol);
    transform-origin: left;
    animation: wb-takt var(--wb-takt, 3800ms) linear both;
  }
  .wb.steht .wb-punkt[aria-current='true'] span::after {
    animation: none;
    transform: none;
  }
  @keyframes wb-takt {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Szenen-Animationen: nur auf der Bühne in der aktiven Szene; Grundzustand = Endbild */
  .wb.ist-buehne .ist-aktiv .a-kachel {
    animation: a-auf 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wb.ist-buehne .ist-aktiv .a-k2 { animation-delay: 0.25s; }
  .wb.ist-buehne .ist-aktiv .a-k3 { animation-delay: 0.5s; }
  .wb.ist-buehne .ist-aktiv .a-k4 { animation-delay: 0.75s; }
  .wb.ist-buehne .ist-aktiv .a-puls {
    animation: a-puls 1.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wb.ist-buehne .ist-aktiv .a-abzeichen {
    animation: a-fallen 0.7s cubic-bezier(0.3, 1.4, 0.5, 1) 0.2s both;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wb.ist-buehne .ist-aktiv .a-haken {
    stroke-dasharray: 1;
    animation: a-zeichnen 0.45s ease-out 0.8s both;
  }
  .wb.ist-buehne .ist-aktiv .a-h1 { animation-delay: 0.3s; }
  .wb.ist-buehne .ist-aktiv .a-h2 { animation-delay: 0.9s; }
  .wb.ist-buehne .ist-aktiv .a-h3 { animation-delay: 1.5s; }
  .wb.ist-buehne .ist-aktiv .a-h4 { animation-delay: 2.1s; }
  .wb.ist-buehne .ist-aktiv .a-stift {
    animation: a-schreiben 2.4s ease-in-out both;
  }
  .wb.ist-buehne .ist-aktiv .a-punkt {
    animation: a-auf 0.3s ease-out both;
    animation-delay: calc(var(--v) * 0.09s);
    transform-box: fill-box;
    transform-origin: center;
  }
  .wb.ist-buehne .ist-aktiv .a-ziel {
    animation: a-auf 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 1.9s both;
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .wb.ist-buehne .ist-aktiv .a-b1 {
    animation: a-auf 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) 0.1s both;
    transform-box: fill-box;
    transform-origin: bottom left;
  }
  .wb.ist-buehne .ist-aktiv .a-tippen {
    animation: a-tippen 1.3s ease-in-out 0.6s both;
  }
  .wb.ist-buehne .ist-aktiv .a-b2 {
    animation: a-auf 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) 1.8s both;
    transform-box: fill-box;
    transform-origin: bottom right;
  }
  .wb.ist-buehne .ist-aktiv .a-stempel {
    animation: a-fallen 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) 0.3s both;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wb.ist-buehne .ist-aktiv .a-funken {
    animation: a-funkeln 2s ease-in-out 0.8s both;
  }
  .wb.ist-buehne .ist-aktiv .a-mond {
    animation: a-auf 0.8s ease-out both;
  }
  .a-tippen {
    opacity: 0;
  }
  @keyframes a-auf {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @keyframes a-fallen {
    from {
      opacity: 0;
      transform: translateY(-30px) rotate(-12deg) scale(1.2);
    }
  }
  @keyframes a-zeichnen {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes a-puls {
    50% {
      transform: scale(1.5);
      opacity: 0.6;
    }
  }
  @keyframes a-schreiben {
    0% { transform: translate(-30px, -96px); }
    25% { transform: translate(-30px, -64px); }
    50% { transform: translate(-30px, -32px); }
    75% { transform: translate(-30px, 0); }
    100% { transform: translate(0, 0); }
  }
  @keyframes a-tippen {
    0%, 100% { opacity: 0; }
    15%, 85% { opacity: 1; }
  }
  @keyframes a-funkeln {
    0% { opacity: 0; }
    40% { opacity: 1; }
    70% { opacity: 0.5; }
    100% { opacity: 1; }
  }
</style>

<script>
  const TAKT = 3800;
  document.querySelectorAll<HTMLElement>('[data-warum]').forEach((wb) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // statische Bildfolge
    const szenen = [...wb.querySelectorAll<HTMLElement>('[data-wb-szene]')];
    const punkte = [...wb.querySelectorAll<HTMLButtonElement>('[data-wb-punkt]')];
    const pause = wb.querySelector<HTMLButtonElement>('[data-wb-pause]');
    if (szenen.length < 2 || !pause) return;

    wb.classList.add('ist-buehne');
    wb.style.setProperty('--wb-takt', `${TAKT}ms`);
    let aktiv = 0;
    let angehalten = false; // vom Nutzer
    let sichtbar = false;
    let schwebt = false;
    let uhr: ReturnType<typeof setTimeout> | undefined;

    const zeigen = (i: number) => {
      aktiv = (i + szenen.length) % szenen.length;
      szenen.forEach((s, j) => {
        s.classList.toggle('ist-aktiv', j === aktiv);
        if (j !== aktiv) s.querySelector('details')?.removeAttribute('open');
      });
      punkte.forEach((p, j) => (j === aktiv ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
      wb.dataset.wbAktiv = String(aktiv);
    };
    const laeuft = () => sichtbar && !angehalten && !schwebt;
    const planen = () => {
      clearTimeout(uhr);
      wb.classList.toggle('ist-pausiert', angehalten);
      wb.classList.toggle('steht', !laeuft());
      if (laeuft()) uhr = setTimeout(() => { zeigen(aktiv + 1); planen(); }, TAKT);
    };
    const setzePause = (an: boolean) => {
      angehalten = an;
      pause.setAttribute('aria-label', an ? 'Animation abspielen' : 'Animation anhalten');
      pause.setAttribute('aria-pressed', String(an));
      planen();
    };

    pause.addEventListener('click', () => setzePause(!angehalten));
    wb.querySelector('[data-wb-weiter]')?.addEventListener('click', () => { zeigen(aktiv + 1); planen(); });
    wb.querySelector('[data-wb-zurueck]')?.addEventListener('click', () => { zeigen(aktiv - 1); planen(); });
    punkte.forEach((p, j) => p.addEventListener('click', () => { zeigen(j); planen(); }));
    // „Mehr erfahren“ geöffnet → anhalten, damit man in Ruhe lesen kann
    wb.querySelectorAll('details').forEach((d) => d.addEventListener('toggle', () => d.open && setzePause(true)));
    const liste = wb.querySelector('[data-wb-liste]');
    liste?.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { schwebt = true; planen(); } });
    liste?.addEventListener('pointerleave', () => { schwebt = false; planen(); });

    new IntersectionObserver(([e]) => { sichtbar = e.isIntersecting; planen(); }, { threshold: 0.35 }).observe(wb);
    zeigen(0);
    pause.setAttribute('aria-pressed', 'false');
  });
</script>

---
// Lernpfad „So läuft's“ (US-06): vier Stationen von der Anmeldung bis zur Prüfung, Daten aus dem nächsten Termin.
// Die SVG-Linie zeichnet sich beim Scrollen (CSS scroll-driven animation, kein JS). Ohne Unterstützung oder bei
// reduzierter Bewegung steht die Linie fertig da.
import { formatDatum } from '../lib/kurse';
import { href } from '../lib/pfad';

interface Props {
  kurz: string; // "AP1"
  slug: string;
  zeiten: string;
  anmeldeschluss: Date;
  start: Date;
  ende: Date;
  pruefung?: Date;
}
const p = Astro.props;

const stationen = [
  {
    titel: 'Termin wählen und anmelden',
    wann: `bis ${formatDatum(p.anmeldeschluss)}`,
    text: 'Ein kurzes Formular. Du zahlst selbst oder dein Betrieb zahlt.',
  },
  {
    titel: 'Rechnung und Zugang per E-Mail',
    wann: 'direkt nach der Anmeldung',
    text: 'Keine Online-Zahlung, kein Kundenkonto.',
  },
  {
    titel: 'Live-Unterricht am Abend',
    wann: `${formatDatum(p.start, 'tagmonat')}–${formatDatum(p.ende)}`,
    text: `${p.zeiten}. Übungsaufgaben besprechen wir gemeinsam live.`,
  },
  {
    titel: 'Prüfung bei deiner IHK',
    wann: p.pruefung ? formatDatum(p.pruefung) : 'laut Einladung deiner IHK',
    text: 'Verbindlich ist die Einladung deiner IHK.',
  },
];
---

<div class="lernpfad relative">
  <!-- Desktop: Welle über alle vier Stationen -->
  <svg class="lp-linie pointer-events-none absolute inset-x-0 top-0 hidden h-16 w-full md:block" viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true">
    <path class="lp-spur" d="M125 32 C 200 2, 300 62, 375 32 S 550 2, 625 32 S 800 62, 875 32" pathLength="1" />
    <path class="lp-zug" d="M125 32 C 200 2, 300 62, 375 32 S 550 2, 625 32 S 800 62, 875 32" pathLength="1" />
  </svg>
  <!-- Mobil: senkrechte Linie links -->
  <svg class="lp-linie pointer-events-none absolute bottom-8 left-[1.375rem] top-8 w-4 md:hidden" viewBox="0 0 16 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="lp-spur" d="M8 0 V 100" pathLength="1" />
    <path class="lp-zug" d="M8 0 V 100" pathLength="1" />
  </svg>

  <ol class="relative grid gap-8 md:grid-cols-4 md:gap-6">
    {
      stationen.map((s, i) => (
        <li class="relative pl-16 md:pl-0 md:pt-20 md:text-center">
          <span
            class:list={[
              'absolute left-0 top-0 grid size-11 place-items-center rounded-full font-serif text-lg font-semibold md:left-1/2 md:top-2.5 md:-translate-x-1/2',
              i === 3 ? 'bg-bernstein text-navy' : 'bg-navy text-white',
            ]}
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="text-xl">{s.titel}</h3>
          <p class="mt-1 text-sm font-semibold text-tief">{s.wann}</p>
          <p class="mt-2 text-gedaempft">{s.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="mt-10 text-sm text-gedaempft md:text-center">
    Beispiel: nächster Termin der {p.kurz}. Alle Kurse und Starttermine findest du unter{' '}<a class="link-fliess" href={href('/termine/')}>Termine</a>.
  </p>
</div>

<style>
  .lp-spur,
  .lp-zug {
    fill: none;
    stroke-linecap: round;
  }
  .lp-spur {
    stroke: var(--color-base-300);
    stroke-width: 2;
    stroke-dasharray: 0.006 0.012;
  }
  .lp-zug {
    stroke: var(--color-petrol);
    stroke-width: 3;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lernpfad {
        view-timeline: --lernpfad block;
      }
      .lp-zug {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: lp-zeichnen linear both;
        animation-timeline: --lernpfad;
        animation-range: entry 20% cover 55%;
      }
    }
  }
  @keyframes lp-zeichnen {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

---
// Kurskarte (US-03): Titel, Säule/Kategorie, Umfang (UE bzw. Minuten), Endpreis und nächster Starttermin –
// alles aus der Content Collection. Aufbau wie ein Kursticket: oben der Kurs, unten (Abriss) Termin und Preis.
import { formatDatum, formatEuro, naechsterTermin, saeulenName, type Kurs } from '../lib/kurse';
import { href } from '../lib/pfad';

interface Props {
  kurs: Kurs;
  /** Überschriftenebene im Seitenkontext */
  ebene?: 'h2' | 'h3';
}
const { kurs, ebene = 'h3' } = Astro.props;
const d = kurs.data;
const Titel = ebene;
const termin = naechsterTermin(kurs);
const istCoaching = d.art === 'coaching';
const istEntwurf = d.status === 'entwurf';
const kursUrl = href(`/kurse/${kurs.id}/`);
const umfang = istCoaching ? '60 Min. je Termin' : d.ue ? `${d.ue} UE` : undefined;

let aktion: { text: string; url: string };
if (istEntwurf) aktion = { text: 'Details ansehen', url: kursUrl };
else if (istCoaching) aktion = { text: 'Paket anfragen', url: href('/coaching/') };
else if (termin) aktion = { text: 'Anmelden', url: href(`/anmeldung/?kurs=${kurs.id}&termin=${termin.id}`) };
else aktion = { text: 'Interesse vormerken', url: href(`/interesse/?kurs=${kurs.id}`) };
---

<article class="karte group relative flex h-full flex-col rounded-[1.5rem] bg-white text-navy ring-1 ring-base-300 transition-shadow hover:shadow-[0_18px_40px_-22px_rgba(0,52,107,0.45)]" data-kurskarte={kurs.id}>
  {
    istEntwurf && (
      <p class="rounded-t-[1.5rem] bg-bernstein px-5 py-2 text-sm font-semibold text-navy" data-entwurf-band>
        Entwurf – noch nicht freigegeben
      </p>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <p class="flex flex-wrap gap-2 text-xs font-semibold">
      <span class="rounded-full bg-base-200 px-3 py-1">{saeulenName(d.saeule)}</span>
      <span class="rounded-full bg-base-200 px-3 py-1">{d.kategorie}</span>
    </p>
    <Titel class="trennen mt-4 text-[1.4rem] sm:text-2xl">
      <a href={kursUrl} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{d.titel}</a>
    </Titel>
    <p class="mt-1 font-medium text-tief">{d.untertitel}</p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gedaempft">
      {umfang && <li class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-petrol" aria-hidden="true" />{umfang}</li>}
      {!istCoaching && <li class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-petrol" aria-hidden="true" />{d.dauer}</li>}
      <li class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-petrol" aria-hidden="true" />Live-Online</li>
    </ul>
  </div>

  <div class="abriss relative mx-6 border-t-2 border-dashed border-base-300" aria-hidden="true"></div>

  <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-4 gap-y-4 p-6 pt-5">
    <div class="min-w-0">
      {
        istCoaching ? (
          <p class="text-sm">
            <span class="block text-gedaempft">Termine</span>
            <span class="font-semibold">flexibel nach Vereinbarung</span>
          </p>
        ) : termin ? (
          <p class="text-sm">
            <span class="block text-gedaempft">Nächster Start</span>
            <span class="font-semibold">
              <time datetime={termin.start.toISOString().slice(0, 10)}>{formatDatum(termin.start, 'wochentag')}</time>
            </span>
            {termin.pruefung && (
              <span class="block text-gedaempft">
                Prüfung {formatDatum(termin.pruefung)}
              </span>
            )}
          </p>
        ) : (
          <p class="text-sm">
            <span class="block text-gedaempft">Termin</span>
            <span class="font-semibold">Termin in Planung – Interesse vormerken</span>
          </p>
        )
      }
    </div>
    <p class="text-right">
      <span class="block text-xs text-gedaempft">{istCoaching ? 'ab' : istEntwurf ? 'Preisvorschlag' : 'Teilnahmegebühr'}</span>
      <span class="font-serif text-3xl font-semibold tabular-nums">{formatEuro(d.preis.betrag)}</span>
      {!istEntwurf && <span class="block text-xs text-gedaempft">Endpreis, alles inklusive</span>}
    </p>
    <a href={aktion.url} class="btn btn-secondary relative z-10 col-span-2 w-full rounded-full">{aktion.text}<span class="sr-only">: {d.titel}</span></a>
  </div>
</article>

<style>
  /* Kursticket: Kerben links und rechts am Abriss */
  .abriss::before,
  .abriss::after {
    content: '';
    position: absolute;
    top: -0.75rem;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 999px;
    background: var(--color-base-100);
    box-shadow: inset 0 0 0 1px var(--color-base-300);
  }
  .abriss::before {
    left: -2.2rem;
    clip-path: inset(0 0 0 50%);
  }
  .abriss::after {
    right: -2.2rem;
    clip-path: inset(0 50% 0 0);
  }
</style>

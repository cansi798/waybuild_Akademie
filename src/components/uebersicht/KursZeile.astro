---
// Eine Zeile der kompakten Kursliste (/kurse/, Ansicht „Liste“): Titel (Link), Umfang, Dauer, nächster Start, Preis.
// Desktop: Spalten wie eine Tabelle (Spaltenköpfe einmal je Kategorie, Etiketten hier nur für Screenreader).
// Mobil: Titel und Preis oben, darunter Umfang · Dauer · Start in einer Zeile. Entwürfe (nur Vorschau) tragen ein Badge.
// Stil: uebersicht.css (.ue-…).
import { formatDatum, formatEuro, isoDatum, naechsterTermin, type Kurs } from '../../lib/kurse';
import { href } from '../../lib/pfad';

interface Props {
  kurs: Kurs;
}
const { kurs } = Astro.props;
const d = kurs.data;
const istCoaching = d.art === 'coaching';
const termin = naechsterTermin(kurs);
const umfang = istCoaching ? 'je 60 Min.' : d.ue ? `${d.ue} UE` : undefined;
const dauer = istCoaching ? 'nach Vereinbarung' : d.dauer;
const preis = `${istCoaching ? 'ab ' : ''}${formatEuro(d.preis.betrag)}`;
---

<div class="ue-zeile" data-kurszeile={kurs.id}>
  <div class="ue-titel">
    <a href={href(`/kurse/${kurs.id}/`)} class="ue-link trennen">{d.titel}</a>
    {d.status === 'entwurf' && <span class="ue-marke" data-entwurf-marke>Entwurf</span>}
    <p class="ue-unter">{d.untertitel}</p>
  </div>
  <div class="ue-werte">
    <p class="ue-wert"><span class="ue-etikett">Umfang: </span>{umfang ?? '–'}</p>
    <p class="ue-wert"><span class="ue-etikett">Dauer: </span>{dauer}</p>
    <p class="ue-wert">
      <span class="ue-etikett">Nächster Start: </span><span class="ue-etikett-mobil" aria-hidden="true">Start </span>
      {istCoaching ? 'flexibel' : termin ? <time datetime={isoDatum(termin.start)}>{formatDatum(termin.start)}</time> : 'Termin folgt'}
    </p>
  </div>
  <p class="ue-preis"><span class="ue-etikett">Preis: </span>{preis}</p>
  <svg aria-hidden="true" viewBox="0 0 20 20" class="ue-pfeil"><path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
</div>

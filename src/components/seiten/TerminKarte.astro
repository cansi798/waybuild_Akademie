---
// Eine Durchführung (Termin) als Karte – für Kursseite, Terminübersicht und Landingpage (US-07, US-28, GR-18).
// Karten statt Tabelle, damit 320 px ohne seitliches Scrollen lesbar bleibt (US-07 AK3).
// Raster: mobil Datum | Zeitraum, darunter Kurs, Angaben, Preis; ab md Datum | Kurs + Angaben | Preis.
import { anmeldeUrl, formatDatum, formatEuro, isoDatum, type Kurs, type Termin } from '../../lib/kurse';
import { href } from '../../lib/pfad';

interface Props {
  kurs: Kurs;
  termin: Termin;
  /** Kursname anzeigen (Terminübersicht/Landing), auf der Kursseite nicht nötig */
  mitKurs?: boolean;
  /** Überschriftenebene für den Kursnamen */
  ebene?: 'h3' | 'h4';
}
const { kurs, termin: t, mitKurs = false, ebene = 'h3' } = Astro.props;
const d = kurs.data;
const Titel = ebene;
const entwurf = d.status === 'entwurf';
const monat = new Intl.DateTimeFormat('de-DE', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(t.start);
---

<li
  class:list={['termin rounded-2xl bg-white p-4 ring-1 ring-base-300 sm:p-5', mitKurs && 'mit-kurs']}
  data-termin={t.id}
  data-kurs={kurs.id}
  data-saeule={d.saeule}
  data-status={d.status}
  data-start={isoDatum(t.start)}
  data-anmeldeschluss={isoDatum(t.anmeldeschluss)}
>
  <time datetime={isoDatum(t.start)} class="t-datum grid w-[4.5rem] place-items-center self-start rounded-xl bg-navy px-2 py-2.5 text-white">
    <span class="font-serif text-3xl leading-none">{formatDatum(t.start, 'tagmonat').slice(0, 2)}</span>
    <span class="mt-1 text-xs whitespace-nowrap">{monat}</span>
  </time>

  {
    mitKurs && (
      <Titel class="t-titel trennen font-sans text-lg leading-snug font-semibold">
        {entwurf && <span class="mr-2 inline-block rounded-full bg-bernstein px-2.5 py-0.5 align-middle text-xs font-semibold text-navy" data-entwurf-marke>Entwurf</span>}
        <a href={href(`/kurse/${kurs.id}/`)} class="hover:underline">{d.titel}</a>
        <span class="block text-base font-medium text-gedaempft">{d.untertitel}</span>
      </Titel>
    )
  }

  <div class="t-zeit min-w-0">
    <p class="font-semibold">
      <span class="whitespace-nowrap">{formatDatum(t.start, 'wochentag')}</span> bis <span class="whitespace-nowrap">{formatDatum(t.ende, 'wochentag')}</span>
    </p>
    <p class="trennen mt-0.5 text-sm text-gedaempft">{d.zeiten} · live online</p>
  </div>

  <div class="t-info min-w-0">
    <dl class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
      {
        t.pruefung && (
          <div class="flex gap-1.5">
            <dt class="text-gedaempft">Prüfung:</dt>
            <dd class="font-semibold" data-pruefungstag>
              {formatDatum(t.pruefung, 'wochentag')}
            </dd>
          </div>
        )
      }
      <div class="flex gap-1.5">
        <dt class="text-gedaempft">Anmeldeschluss:</dt>
        <dd class="font-semibold">{formatDatum(t.anmeldeschluss)}</dd>
      </div>
    </dl>
    {t.pruefung && <p class="mt-1 text-sm text-gedaempft">{t.pruefungHinweis ?? 'Verbindlich ist die Einladung deiner IHK.'}</p>}
    {
      t.ausfall.length > 0 && (
        <p class="mt-2 inline-flex rounded-lg bg-base-200 px-3 py-1.5 text-sm" data-ausfall>
          Kein Unterricht am {t.ausfall.map((a) => formatDatum(a)).join(', ')}
        </p>
      )
    }
  </div>

  <div class="t-preis flex flex-wrap items-center justify-between gap-3 border-t border-base-300 pt-4 md:flex-col md:items-end md:justify-center md:border-0 md:pt-0">
    <p class="md:text-right">
      <span class="font-serif text-2xl font-semibold tabular-nums">{formatEuro(d.preis.betrag)}</span>
      <span class="block text-xs text-gedaempft">{entwurf ? 'Preisvorschlag' : 'Endpreis, alles inklusive'}</span>
    </p>
    {
      entwurf ? (
        <span class="rounded-full bg-base-200 px-4 py-2 text-sm font-semibold">Anmeldung nach Freigabe</span>
      ) : (
        <a href={href(anmeldeUrl(kurs, t))} class="btn btn-secondary rounded-full px-6" data-anmelden>
          Anmelden<span class="sr-only">: {d.titel}, Start {formatDatum(t.start)}</span>
        </a>
      )
    }
  </div>
</li>

<style>
  .termin {
    display: grid;
    column-gap: 1rem;
    row-gap: 0.9rem;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'datum zeit'
      'info info'
      'preis preis';
  }
  .termin.mit-kurs {
    grid-template-areas:
      'datum zeit'
      'titel titel'
      'info info'
      'preis preis';
  }
  .termin[hidden] {
    display: none;
  }
  .t-datum { grid-area: datum; }
  .t-titel { grid-area: titel; }
  .t-zeit { grid-area: zeit; align-self: center; }
  .t-info { grid-area: info; }
  .t-preis { grid-area: preis; }
  @media (min-width: 48rem) {
    .termin {
      column-gap: 1.5rem;
      row-gap: 0.5rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'datum zeit preis'
        'datum info preis';
    }
    .termin.mit-kurs {
      grid-template-areas:
        'datum titel preis'
        'datum zeit preis'
        'datum info preis';
    }
    .t-zeit { align-self: start; }
  }
</style>

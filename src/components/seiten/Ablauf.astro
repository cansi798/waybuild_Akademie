---
// Kompakter Ablauf „So läuft's ab“ (US-06 AK2) für Kursseiten – ohne Termin-Daten, gilt für jeden Kurs.
interface Props {
  coaching?: boolean;
}
const { coaching = false } = Astro.props;
const schritte = coaching
  ? [
      { t: 'Anliegen schildern', x: 'Kurzes Anfrageformular: Paket, Thema und Prüfungszeitraum.' },
      { t: 'Termine abstimmen', x: 'Wir melden uns und vereinbaren passende Online-Termine. Erst dann wird es verbindlich.' },
      { t: '1:1 online', x: 'Je 60 Minuten Beratung, Rückmeldung und Training – live per Videokonferenz.' },
      { t: 'Rechnung per E-Mail', x: 'An dich oder an deinen Betrieb. Keine Online-Zahlung.' },
    ]
  : [
      { t: 'Termin wählen', x: 'Anmelden per kurzem Formular – bis 7 Tage vor Kursstart.' },
      { t: 'Rechnung per E-Mail', x: 'An dich oder an deinen Betrieb. Keine Online-Zahlung, kein Kundenkonto.' },
      { t: 'Zugang per E-Mail', x: 'Vor dem Start bekommst du den Link zum Live-Raum.' },
      { t: 'Live dabei sein', x: 'Unterricht in Echtzeit mit Fragen und Übungen – gemeinsam in der Gruppe.' },
    ];
---

<ol class="grid gap-4 sm:grid-cols-2" data-ablauf>
  {
    schritte.map((s, i) => (
      <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-base-300">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-navy font-serif text-lg text-white" aria-hidden="true">{i + 1}</span>
        <span>
          <span class="block font-semibold">{s.t}</span>
          <span class="mt-1 block text-sm text-gedaempft">{s.x}</span>
        </span>
      </li>
    ))
  }
</ol>

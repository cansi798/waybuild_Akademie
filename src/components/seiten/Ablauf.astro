---
// „So läuft's“ – EINE gemeinsame Komponente (Conversion-Konzept E) für Kursseiten, Landing, Coaching und Anmeldung.
// Rechtsmodell seit #6771 (Teilnahmebedingungen #vertragsschluss): Unverbindlich anfragen → Buchungsangebot per E-Mail →
// Zusage per Antwort-Mail → unsere Buchungsbestätigung (Ziel, Bernstein markiert). Mit Termin-Daten (Landing) steht unter
// jedem Schritt der passende Zeitpunkt. Coaching: gleiche vier Schritte, eigene Texte (Termine werden abgestimmt).
import { formatDatum } from '../../lib/kurse';

interface Props {
  coaching?: boolean;
  /** Daten des nächsten Termins (optional) */
  termin?: { anmeldeschluss: Date; start: Date; ende: Date; pruefung?: Date };
  /** senkrechte, kleine Liste (Seitenleiste der Anmeldung) */
  kompakt?: boolean;
  /** Überschriftenebene der Schritte */
  ebene?: 'h3' | 'h4';
}
const { coaching = false, termin: t, kompakt = false, ebene = 'h3' } = Astro.props;
const Titel = ebene;

type Schritt = { titel: string; text: string; wann?: string };
const schritte: Schritt[] = coaching
  ? [
      { titel: 'Unverbindlich anfragen', text: 'Paket, Thema und Prüfungszeitraum angeben. Kein Kundenkonto, keine Zahlungspflicht.' },
      { titel: 'Buchungsangebot per E-Mail', text: 'Wir schlagen dir passende Online-Termine vor und schicken dir das Angebot mit allen Unterlagen.' },
      { titel: 'Zusage per Antwort-Mail', text: 'Passen Termine und Angebot, sagst du einfach per Antwort-Mail zu. Bis dahin ist nichts verbindlich.' },
      { titel: 'Unsere Bestätigung', text: 'Mit unserer Buchungsbestätigung per E-Mail ist das Coaching verbindlich. Die Rechnung kommt per E-Mail, keine Online-Zahlung.' },
    ]
  : [
      { titel: 'Unverbindlich anfragen', text: 'Ein kurzes Formular, kein Kundenkonto, keine Zahlungspflicht. Anfragen bis 7 Tage vor Kursstart.', wann: t && `bis ${formatDatum(t.anmeldeschluss)}` },
      { titel: 'Buchungsangebot per E-Mail', text: 'Wir prüfen den Termin und schicken dir in der Regel innerhalb von zwei Werktagen ein Buchungsangebot mit allen Unterlagen.', wann: t && 'nach deiner Anfrage' },
      { titel: 'Zusage per Antwort-Mail', text: 'Passt alles, sagst du einfach per Antwort-Mail zu. Bis dahin kannst du jederzeit formlos absagen.' },
      {
        titel: 'Unsere Bestätigung',
        text: 'Mit unserer Buchungsbestätigung per E-Mail ist dein Platz verbindlich. Danach kommt die Rechnung, keine Online-Zahlung. Vor dem Start bekommst du deinen Nextcloud-Zugang und den Link zum Live-Raum – der Unterricht läuft über unsere eigene Videokonferenz.',
        wann: t && `Kursstart ${formatDatum(t.start)}`,
      },
    ];
const letzter = schritte.length - 1;
---

{
  kompakt ? (
    <ol class="grid gap-4 text-sm" data-ablauf>
      {schritte.map((s, i) => (
        <li class="flex gap-3">
          <span class:list={['grid size-8 shrink-0 place-items-center rounded-full font-serif font-semibold', i === letzter ? 'bg-bernstein text-navy' : 'bg-navy text-white']} aria-hidden="true">
            {i + 1}
          </span>
          <span>
            <span class="block font-semibold text-navy">{s.titel}</span>
            <span class="text-gedaempft">{s.text}</span>
          </span>
        </li>
      ))}
    </ol>
  ) : (
    <div class="@container">
      <ol class="ablauf grid gap-x-8 gap-y-8 @lg:grid-cols-2 @4xl:grid-cols-4" data-ablauf>
        {schritte.map((s, i) => (
          <li class:list={['relative min-w-0 border-t-2 pt-5', i === letzter ? 'border-bernstein' : 'border-navy/20']} data-schritt={i + 1}>
            <span class="flex items-baseline gap-3">
              <span class="font-serif text-4xl leading-none font-semibold text-navy tabular-nums" aria-hidden="true">{i + 1}</span>
              {i === letzter && <span class="size-2.5 rounded-full bg-bernstein" aria-hidden="true" />}
            </span>
            <Titel class="mt-3 font-sans text-lg leading-snug font-semibold text-navy">
              <span class="sr-only">Schritt {i + 1}: </span>
              {s.titel}
            </Titel>
            {s.wann && <p class="mt-1 text-sm font-semibold text-tief tabular-nums">{s.wann}</p>}
            <p class="mt-2 text-gedaempft">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  )
}

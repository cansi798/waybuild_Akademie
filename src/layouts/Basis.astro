---
// Grundlayout aller Seiten: SEO-Meta/OG, noindex in der Vorschau, Vorschau-Banner, Skip-Link, Kopf, Fuß.
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import { IS_PREVIEW } from '../lib/env';
import { AKADEMIE } from '../lib/site';
import { href, absolut } from '../lib/pfad';
// Die zwei Schriftdateien des ersten Bildes (lateinischer Zeichensatz) vorladen – zusammen mit den maßgleichen
// Ersatzschriften in global.css verhindert das Springen beim Schrift-Tausch (CLS).
import interLatein from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesLatein from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  /** Seitentitel ohne Marke (wird zu „Titel | waybuild Akademie“) */
  titel: string;
  beschreibung?: string;
  /** Seite unabhängig von der Vorschau nicht indexieren (z. B. Danke-Seite) */
  noindex?: boolean;
  /** Zusätzliche JSON-LD-Objekte */
  schema?: Record<string, unknown>[];
}

const { titel, beschreibung = AKADEMIE.beschreibung, noindex = false, schema = [] } = Astro.props;
const vollerTitel = titel.includes(AKADEMIE.name) ? titel : `${titel} | ${AKADEMIE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogBild = absolut('/og-bild.png', Astro.site);
const robots = IS_PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow';

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${absolut('/', Astro.site)}#organisation`,
  name: AKADEMIE.name,
  url: absolut('/', Astro.site),
  logo: absolut('/logo/waybuild-akademie.svg', Astro.site),
  email: AKADEMIE.mailInfo,
  description: AKADEMIE.beschreibung,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{vollerTitel}</title>
    <link rel="preload" href={interLatein} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatein} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={beschreibung} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#00346b" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={AKADEMIE.name} />
    <meta property="og:title" content={vollerTitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="waybuild Akademie – Live-Online-Kurse und IHK-Prüfungsvorbereitung" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([organisation, ...schema])} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-navy focus:px-4 focus:py-3 focus:text-white"
      >Zum Inhalt springen</a
    >
    {
      IS_PREVIEW && (
        <aside class="bg-bernstein text-navy text-sm" aria-label="Hinweis zur Vorschau" data-vorschau-banner>
          <p class="rahmen py-2 text-center font-medium">
            Vorschau – nicht öffentlich. Inhalte, Termine und Preise werden noch geprüft.
          </p>
        </aside>
      )
    }
    <Kopf />
    <main id="inhalt" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Fuss />
  </body>
</html>
